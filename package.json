{
  "name": "spy",
  "displayName": "PySpy",
  "description": "Automated tool for analysing and testing Python code snippets in real time.",
  "icon": "assets/play_512.png",
  "version": "0.1.0",
  "preview": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spy.PurgeCachedFiles",
        "title": "Clean File Cache",
        "category": "PySpy",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "PySpy",
      "properties": {
        "spy.AnalysisEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether or not to attempt static analysis and linting for tagged functions."
        },
        "spy.RadonInstallLocation": {
          "type": ["string", "null"],
          "default": null,
          "description": "Where the Radon tool can be found for additional analysis."
        },
        "spy.TestingEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether or not to attempt interface and coverage testing for tagged functions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.96.0",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.16.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "python-shell": "^5.0.0"
  }
}
